{
  "name": "dahiraconnect",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "node scripts/pull-content.mjs && ng build && node scripts/postbuild.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "icons": "python3 scripts/subset-icons.py",
    "preview": "wrangler dev",
    "deploy": "npm run build && npx wrangler pages deploy dist/dahiraconnect/browser --project-name dahiraconnect-sites --branch main",
    "seed": "node scripts/seed-from-mock.mjs",
    "build:worker": "ng build --configuration production,worker && node scripts/postbuild-worker.mjs",
    "types:worker": "wrangler types --strict-vars false --include-main-module false",
    "test:worker": "node --test scripts/worker.test.mjs",
    "deploy:worker": "npm run build:worker && wrangler deploy",
    "test:worker:smoke": "node scripts/smoke-worker.mjs",
    "deploy:worker:preview": "npm run build:worker && wrangler deploy --env preview"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/forms": "^20.3.0",
    "@angular/platform-browser": "^20.3.0",
    "@angular/platform-server": "^20.3.0",
    "@angular/router": "^20.3.0",
    "@angular/service-worker": "^20.3.0",
    "@angular/ssr": "^20.3.43",
    "@phosphor-icons/web": "^2.1.2",
    "@supabase/supabase-js": "^2.119.2",
    "chart.js": "^4.6.1",
    "express": "^5.1.0",
    "read-excel-file": "^5.8.8",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "write-excel-file": "^2.3.10",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^20.3.1",
    "@angular/cli": "^20.3.1",
    "@angular/compiler-cli": "^20.3.0",
    "@types/express": "^5.0.1",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^20.17.19",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.9.2",
    "wrangler": "4.164.0"
  }
}
