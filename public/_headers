# En-têtes Cloudflare Pages

# Fichiers du build (nom avec empreinte) : cache long
/*.js
  Cache-Control: public, max-age=31536000, immutable
/*.css
  Cache-Control: public, max-age=31536000, immutable
/media/*
  Cache-Control: public, max-age=31536000, immutable
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Service worker et manifeste : toujours revérifiés (mises à jour du site)
# « ! Cache-Control » retire d'abord la règle /*.js (sinon les deux s'additionnent)
/ngsw-worker.js
  ! Cache-Control
  Cache-Control: no-cache
/ngsw.json
  ! Cache-Control
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache
  Content-Type: application/manifest+json

# Sécurité
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN

# Calendrier en ligne : type correct, revérifié régulièrement
/agenda.ics
  Content-Type: text/calendar; charset=utf-8
  Cache-Control: public, max-age=3600

# Espace des responsables : jamais dans les moteurs de recherche
/admin
  X-Robots-Tag: noindex, nofollow
/admin/*
  X-Robots-Tag: noindex, nofollow
